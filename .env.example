# Local settings for development. `pnpm setup:env` copies this file to .env.local, which Git
# ignores. Put your values in .env.local, never in this file. See README, Development setup.
#
# `convex dev` adds CONVEX_DEPLOYMENT, NEXT_PUBLIC_CONVEX_URL, and NEXT_PUBLIC_CONVEX_SITE_URL
# on its first run. Do not add them by hand.

# Clerk dashboard > Configure > API keys (README step 1).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
# Secret. Select "Add new key". Clerk shows the full key only once.
CLERK_SECRET_KEY=

# Use the in-app /sign-in page, not the Clerk-hosted page.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Optional. Secret. The Signing Secret of the Clerk webhook endpoint (README step 7).
# CLERK_WEBHOOK_SIGNING_SECRET=

# Optional. Password for new seed users. Without it, they sign in with the code 424242.
# SEED_USER_PASSWORD=

# Optional. Host ports for n8n and Mailpit, if the defaults (5678, 8025) are taken.
# N8N_HOST_PORT=5678
# MAILPIT_HOST_PORT=8025
