{
  "name": "lendloop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "setup:env": "node scripts/env-setup.mjs",
    "setup:convex": "node --env-file=.env.local scripts/convex-setup.mjs",
    "setup:clerk": "node --env-file=.env.local scripts/clerk-setup.mjs",
    "setup:n8n": "node --env-file-if-exists=.env.local scripts/n8n-setup.mjs",
    "dev": "pnpm containers:up && hivemind Procfile.dev",
    "dev:web": "next dev",
    "build": "next build",
    "start": "next start",
    "containers:up": "node --env-file-if-exists=.env.local scripts/compose.mjs up -d",
    "containers:down": "node --env-file-if-exists=.env.local scripts/compose.mjs down",
    "containers:logs": "node --env-file-if-exists=.env.local scripts/compose.mjs logs -f",
    "db:seed": "node --env-file=.env.local scripts/seed.mjs",
    "db:reset": "node scripts/db-reset.mjs",
    "admin:grant": "node scripts/admin.mjs grant",
    "admin:revoke": "node scripts/admin.mjs revoke",
    "lint": "oxlint && eslint",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "tsc --noEmit",
    "test": "vitest",
    "test:once": "vitest run",
    "check": "pnpm format:check && pnpm typecheck && pnpm lint && pnpm test:once"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@clerk/backend": "^3.26.4",
    "@clerk/nextjs": "^7.9.22",
    "@clerk/ui": "^1.42.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.1",
    "convex": "^1.48.0",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.65.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.3.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "convex-test": "^0.0.66",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "eslint-plugin-oxlint": "^1.90.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "shadcn": "^4.23.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.11.2"
}
